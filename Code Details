#include <Wire.h>
#include "RTClib.h"
#include "DHT.h"

// DHT11 Configuration
#define DHTPIN 2         // The pin where the sensor is connected (D2)
#define DHTTYPE DHT11    // Defining sensor type u can change what type sensor u use
DHT dht(DHTPIN, DHTTYPE);

// RTC Configuration (DS3231 is the most common for Nano)
RTC_DS3231 rtc;

void setup() {
  Serial.begin(9600);
  
  // Initialize DHT sensor
  dht.begin();

  // Initialize RTC module
  if (!rtc.begin()) {
    Serial.println("Couldn't find RTC!");
    while (1); // Stop execution if RTC is missing
  }

  // Check if the RTC lost power and needs a time reset
  if (rtc.lostPower()) {
    Serial.println("RTC lost power, setting the time...");
    // This line sets the RTC's date & time same as ur computer do not use if RTC is correct
    // If u use add "//" to code for deactivite line
    rtc.adjust(DateTime(F(__DATE__), F(__TIME__)));
  }
}

void loop() {
  // Wait 2 seconds between measurements if u use dht22(1000) or sht(100) delay is enough
  delay(2000);

  // Get current time
  DateTime now = rtc.now();

  // Read humidity and temperature
  float humidity = dht.readHumidity();
  float temperature = dht.readTemperature();

  // Error handling
  if (isnan(humidity) || isnan(temperature)) {
    Serial.println(F("Failed to read from DHT sensor!"));
    return;
  }

  // Print Date and Time
  Serial.print("[");
  Serial.print(now.year(), DEC);
  Serial.print('/');
  Serial.print(now.month(), DEC);
  Serial.print('/');
  Serial.print(now.day(), DEC);
  Serial.print(" ");
  Serial.print(now.hour(), DEC);
  Serial.print(':');
  if (now.minute() < 10) Serial.print('0'); // Leading zero for minutes
  Serial.print(now.minute(), DEC);
  Serial.print(':');
  if (now.second() < 10) Serial.print('0'); // Leading zero for seconds
  Serial.print(now.second(), DEC);
  Serial.print("] ");

  // Print Sensor Data 
  Serial.print(F("Temp: "));
  Serial.print(temperature);
  Serial.print(F("°C | Humidity: "));
  Serial.print(humidity);
  Serial.println(F("%"));
}

